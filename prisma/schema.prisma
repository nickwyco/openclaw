// OpenClaw data model — a Sellbrite-style multi-channel listing & inventory hub.
//
// Core idea: a single catalog of Products with multi-warehouse Inventory is the
// source of truth. Each Product is published to one or more sales Channels as a
// Listing. When inventory or price changes, the sync engine pushes updates to
// every active Listing. Orders flow back in from each Channel into one inbox.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts & users
// ---------------------------------------------------------------------------

model Account {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  products   Product[]
  warehouses Warehouse[]
  channels   Channel[]
  orders     Order[]
  templates  ListingTemplate[]
}

model User {
  id        String   @id @default(cuid())
  accountId String
  email     String   @unique
  name      String?
  role      UserRole @default(OWNER)
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
  READONLY
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Product {
  id          String  @id @default(cuid())
  accountId   String
  sku         String
  title       String
  description String? @db.Text
  brand       String?
  manufacturer String?
  category    String?
  condition   ProductCondition @default(NEW)

  // Pricing & costs (stored in minor units / cents to avoid float drift).
  priceCents Int  @default(0)
  costCents  Int  @default(0)
  currency   String @default("USD")

  // Identifiers used by marketplaces.
  upc  String?
  ean  String?
  isbn String?
  gtin String?
  mpn  String?

  // Physical attributes for shipping & marketplace requirements.
  weightGrams Int?
  lengthMm    Int?
  widthMm     Int?
  heightMm    Int?

  status    ProductStatus @default(ACTIVE)
  archived  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  account        Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  variants       ProductVariant[]
  images         ProductImage[]
  inventoryItems InventoryItem[]
  listings       Listing[]
  orderItems     OrderItem[]

  @@unique([accountId, sku])
  @@index([accountId])
  @@index([accountId, status])
}

model ProductVariant {
  id         String @id @default(cuid())
  productId  String
  sku        String
  optionName String // e.g. "Size / Color"
  optionValue String // e.g. "Large / Red"
  priceCents Int?
  upc        String?
  createdAt  DateTime @default(now())

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@unique([productId, sku])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum ProductCondition {
  NEW
  USED_LIKE_NEW
  USED_GOOD
  USED_ACCEPTABLE
  REFURBISHED
  FOR_PARTS
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Warehouses & inventory (multi-location, the source of truth)
// ---------------------------------------------------------------------------

model Warehouse {
  id        String  @id @default(cuid())
  accountId String
  name      String
  code      String
  address1  String?
  city      String?
  region    String?
  postal    String?
  country   String  @default("US")
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())

  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@unique([accountId, code])
  @@index([accountId])
}

// One row per (product/variant) per warehouse.
model InventoryItem {
  id          String  @id @default(cuid())
  productId   String
  variantId   String?
  warehouseId String

  onHand      Int @default(0) // physical units in the building
  reserved    Int @default(0) // committed to unshipped orders
  // available = onHand - reserved (computed in app layer)

  reorderPoint Int @default(0)
  reorderQty   Int @default(0)

  binLocation String?
  updatedAt   DateTime @updatedAt

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@unique([productId, variantId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

// Append-only audit trail of every stock change.
model InventoryMovement {
  id              String   @id @default(cuid())
  inventoryItemId String
  delta           Int // +received, -sold/adjusted
  reason          MovementReason
  reference       String? // e.g. order id, PO number
  note            String?
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
}

enum MovementReason {
  PURCHASE_RECEIVED
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER
  DAMAGE
  RECOUNT
}

// ---------------------------------------------------------------------------
// Channels (marketplace connections)
// ---------------------------------------------------------------------------

model Channel {
  id        String          @id @default(cuid())
  accountId String
  type      ChannelType
  name      String // user-facing label, e.g. "eBay — US store"
  status    ChannelStatus   @default(DISCONNECTED)

  // OAuth / credential material. Encrypt at rest in production.
  accessToken  String?  @db.Text
  refreshToken String?  @db.Text
  tokenExpires DateTime?
  externalId   String? // shop id / merchant id / seller id
  shopDomain   String? // shopify myshopify.com domain
  config       Json? // adapter-specific settings (marketplace id, location id…)

  // Pricing rules applied when publishing to this channel.
  priceMarkupPct Float @default(0) // +10 means list 10% above catalog price
  autoSync       Boolean @default(true)

  lastSyncAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  listings  Listing[]
  orders    Order[]
  syncLogs  SyncLog[]

  @@index([accountId])
}

enum ChannelType {
  EBAY
  ETSY
  SHOPIFY
  AMAZON
  WALMART
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  EXPIRED
}

// ---------------------------------------------------------------------------
// Listings (a product published to a channel)
// ---------------------------------------------------------------------------

model Listing {
  id        String @id @default(cuid())
  productId String
  channelId String

  externalId  String? // marketplace listing id (eBay item id, Etsy listing id…)
  externalUrl String?

  title       String?
  description String? @db.Text

  // Channel-specific overrides. Null falls back to the catalog Product.
  priceCents  Int?
  // Quantity currently published to the channel (mirror of available stock).
  publishedQty Int @default(0)

  status      ListingStatus @default(DRAFT)
  lastError   String?       @db.Text
  templateId  String?

  publishedAt DateTime?
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  channel  Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  template ListingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([productId, channelId])
  @@index([channelId])
  @@index([productId])
  @@index([status])
}

enum ListingStatus {
  DRAFT       // created locally, not yet on the channel
  PUBLISHING  // push in flight
  ACTIVE      // live on the channel
  INACTIVE    // ended / out of stock
  ERROR       // last push failed
}

// Reusable recipe for generating listings (title prefixes, policies, etc.).
model ListingTemplate {
  id          String @id @default(cuid())
  accountId   String
  name        String
  channelType ChannelType

  titlePattern       String? // e.g. "{brand} {title} — Fast Ship"
  descriptionPattern String? @db.Text
  // Channel policy ids (eBay payment/return/fulfillment, Etsy section…).
  settings           Json?

  createdAt DateTime @default(now())

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Orders (unified inbox from every channel)
// ---------------------------------------------------------------------------

model Order {
  id        String @id @default(cuid())
  accountId String
  channelId String

  externalId   String // marketplace order id
  orderNumber  String // human-friendly number

  status        OrderStatus     @default(AWAITING_FULFILLMENT)
  financialStatus FinancialStatus @default(PAID)

  // Money (cents).
  subtotalCents Int @default(0)
  shippingCents Int @default(0)
  taxCents      Int @default(0)
  totalCents    Int @default(0)
  currency      String @default("USD")

  buyerName  String?
  buyerEmail String?

  shipName    String?
  shipAddress1 String?
  shipAddress2 String?
  shipCity    String?
  shipRegion  String?
  shipPostal  String?
  shipCountry String?

  // Fulfillment.
  trackingNumber String?
  carrier        String?
  shippedAt      DateTime?

  placedAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channel Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  items   OrderItem[]

  @@unique([channelId, externalId])
  @@index([accountId])
  @@index([accountId, status])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String?

  sku       String
  title     String
  quantity  Int
  priceCents Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

enum OrderStatus {
  AWAITING_PAYMENT
  AWAITING_FULFILLMENT
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  ON_HOLD
}

enum FinancialStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

// ---------------------------------------------------------------------------
// Sync log (observability for every push/pull to a channel)
// ---------------------------------------------------------------------------

model SyncLog {
  id        String  @id @default(cuid())
  channelId String?
  kind      SyncKind
  status    SyncStatus
  message   String   @db.Text
  detail    Json?
  createdAt DateTime @default(now())

  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([channelId])
  @@index([kind])
  @@index([createdAt])
}

enum SyncKind {
  LISTING_PUBLISH
  LISTING_UPDATE
  INVENTORY_PUSH
  ORDER_IMPORT
  FULFILLMENT_PUSH
  OAUTH
}

enum SyncStatus {
  SUCCESS
  FAILURE
  SKIPPED
}
