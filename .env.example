# ---------------------------------------------------------------------------
# OpenClaw environment configuration
# Copy this file to `.env` and fill in real values.
# The app runs without any marketplace credentials — adapters degrade to a
# safe "not connected" mode and the UI/seed data still work end-to-end.
# ---------------------------------------------------------------------------

# Database (PostgreSQL). docker-compose.yml provisions a matching instance.
DATABASE_URL="postgresql://openclaw:openclaw@localhost:5432/openclaw?schema=public"

# Base URL of this app (used for OAuth redirect URIs).
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# eBay — https://developer.ebay.com  (Sell APIs, OAuth2)
# ---------------------------------------------------------------------------
EBAY_ENV="SANDBOX"                       # SANDBOX | PRODUCTION
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_RU_NAME=""                          # Redirect URL name (RuName)
EBAY_REDIRECT_URI="${APP_URL}/api/oauth/callback"

# ---------------------------------------------------------------------------
# Etsy — https://developers.etsy.com  (Open API v3, OAuth2 PKCE)
# ---------------------------------------------------------------------------
ETSY_KEYSTRING=""                        # API key (client id)
ETSY_SHARED_SECRET=""
ETSY_REDIRECT_URI="${APP_URL}/api/oauth/callback"

# ---------------------------------------------------------------------------
# Shopify — https://shopify.dev  (Admin API, custom/public app)
# ---------------------------------------------------------------------------
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_API_VERSION="2024-10"
SHOPIFY_SCOPES="read_products,write_products,read_orders,write_inventory,read_inventory,read_locations"
SHOPIFY_REDIRECT_URI="${APP_URL}/api/oauth/callback"

# ---------------------------------------------------------------------------
# Amazon Selling Partner API (secondary) — https://developer-docs.amazon.com
# ---------------------------------------------------------------------------
AMAZON_LWA_CLIENT_ID=""
AMAZON_LWA_CLIENT_SECRET=""
AMAZON_SP_REGION="na"                    # na | eu | fe
AMAZON_REFRESH_TOKEN=""

# ---------------------------------------------------------------------------
# Walmart Marketplace (secondary) — https://developer.walmart.com
# ---------------------------------------------------------------------------
WALMART_CLIENT_ID=""
WALMART_CLIENT_SECRET=""
